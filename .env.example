# NexusMart Core Backend — Local Development & Sandbox Environment Variables
# NEVER commit real production secrets to this repository.

# --- Shared Infrastructure ---
POSTGRES_USER=nexusmart
POSTGRES_PASSWORD=nexusmart_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_PORT=6379

NATS_URL=nats://nats:4222
NATS_STREAM=NEXUSMART
NATS_PORT=4222
NATS_MONITOR_PORT=8222

OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_PROM_PORT=8889
OTEL_HEALTH_PORT=13133
LOG_LEVEL=info

# --- Service Host Port Bindings (container ports stay fixed) ---
# gRPC ports (50051-50059) are internal to the compose network and never published to the host.
# Published ports except GATEWAY_PORT and WEB_PORT bind to 127.0.0.1 only; use an SSH tunnel for remote access.
USER_HTTP_PORT=8081
PRODUCT_HTTP_PORT=8082
CART_HTTP_PORT=8083
PROMOTION_HTTP_PORT=8084
ORDER_HTTP_PORT=8085
NOTIFICATION_HTTP_PORT=8088
SEARCH_HTTP_PORT=8089

# --- Mailpit (Local SMTP Sandbox) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@nexusmart.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Auth & Security (Dev/Sandbox Defaults Only) ---
JWT_SECRET=dev-only-nexusmart-hs256-secret-change-me
# Separate key for short-lived internal service tokens (saga/jobs/consumers). Must differ from JWT_SECRET.
SERVICE_JWT_SECRET=dev-only-nexusmart-service-hs256-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=168h
ADMIN_BOOTSTRAP_EMAIL=admin@nexusmart.local
ADMIN_BOOTSTRAP_PASSWORD=AdminDevPassword123!
USER_BANK_PAYOUT_LOCK_HOURS=24
# Dev/sandbox phone OTP is SMS-mocked via account email (Mailpit); phone_verified does not prove phone possession until a real SMS provider is integrated (E19).
USER_PHONE_OTP_TTL_SECONDS=300
USER_PHONE_OTP_COOLDOWN_SECONDS=60
USER_PHONE_OTP_MAX_PER_HOUR=5
# Dev-only 32-byte base64 key ("dev-only-bank-account-key-32byte") for encrypting shop bank account numbers; MUST replace in production.
# Generate a production key with: openssl rand -base64 32
BANK_ACCOUNT_KEY=ZGV2LW9ubHktYmFuay1hY2NvdW50LWtleS0zMmJ5dGU=

# --- Gateway Rate Limiting ---
GATEWAY_PORT=8080
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=180
RATE_LIMIT_FLASH_SALE_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_BANK_OTP_PER_MIN=5
RATE_LIMIT_PHONE_OTP_PER_MIN=5
RATE_LIMIT_SHIPPING_FEE_PER_MIN=30
RATE_LIMIT_ORDER_LOOKUP_PER_MIN=10
RATE_LIMIT_ORDER_LOOKUP_CODE_PER_10MIN=5
RATE_LIMIT_WEBHOOK_PER_MIN=600
SEARCH_FALLBACK_TIMEOUT_MS=1500
# Comma-separated trusted proxy CIDRs, IPs, or hostnames (empty disables XFF/X-Real-IP; compose sets web).
TRUSTED_PROXIES=web

# --- Payment Service (Rust, Sandbox/Mock) ---
PAYMENT_HTTP_PORT=8086
VIETQR_MODE=mock
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-hmac-secret
PAYMENT_EXPIRY_MINUTES=15
PAYMENT_SELLER_HOLD_HOURS=72
# Two-person approval threshold (VND) for manual admin refunds & large return refunds (24h rolling sum per payment) (F11).
PAYMENT_LARGE_REFUND_APPROVAL_VND=5000000
PAYOS_CLIENT_ID=sandbox-client-id
PAYOS_API_KEY=sandbox-api-key
PAYOS_CHECKSUM_KEY=sandbox-checksum-key
SEPAY_API_TOKEN=sandbox-sepay-token
# ZaloPay v2 adapter: only "mock" or "sandbox" (default "mock"). Keys MUST come from env; empty keys prevent sandbox startup. Never commit keys (F1).
ZALOPAY_MODE=mock
ZALOPAY_BASE_URL=https://sb-openapi.zalopay.vn
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=http://localhost:8080/webhooks/zalopay
ZALOPAY_REDIRECT_URL=http://localhost:3000/thanh-toan/cho-thanh-toan
ZALOPAY_HTTP_TIMEOUT_SECS=10
ZALOPAY_LATE_SWEEP_WINDOW_HOURS=24
ZALOPAY_LATE_SWEEP_BATCH_LIMIT=25

# --- Shipping Service (GHN Sandbox + Mock Adapter) ---
SHIPPING_HTTP_PORT=8087
# Internal gRPC addresses for host dev (used by product, shipping & notification; compose overrides to service:port).
USER_GRPC_ADDR=localhost:50051
ORDER_GRPC_ADDR=localhost:50055
SHIPPING_WEBHOOK_SECRET=dev-only-shipping-webhook-hmac-secret
SHIPPING_MAX_REDELIVERY=3
SHIPPING_FEE_CACHE_TTL_SECONDS=60
SHIPPING_CREATE_RETRY_MAX=8
SHIPPING_CREATE_RETRY_BASE_MS=2000
SHIPPING_CREATE_RETRY_MAX_BACKOFF_MS=300000
SHIPPING_CREATE_WORKER_INTERVAL_MS=2000
# Carrier sync attempts per call (set CARRIER_MAX_RETRIES=1 in isolated E18 fault-injection test environments).
CARRIER_MAX_RETRIES=3
# Carrier circuit breaker failure threshold (set CARRIER_CB_MAX_FAILURES=100 in isolated E18 fault-injection test environments).
CARRIER_CB_MAX_FAILURES=3
# Carrier circuit breaker open duration before half-open probe (default 30s).
CARRIER_CB_OPEN_TIMEOUT=30s
# Test-only carrier fault injection hook (enable ONLY in isolated test environments, never in production).
SHIPPING_TEST_FAULT_INJECTION=false
# Dev-only 32-byte base64 key ("dev-only-shipping-config-key-32b") for encrypting carrier tokens; MUST replace in production.
SHIPPING_CONFIG_KEY=ZGV2LW9ubHktc2hpcHBpbmctY29uZmlnLWtleS0zMmI=
# Browser-accessible shipping label base URL (via web BFF /api/gw/shipping/labels -> gateway /api/v1/shipping/labels).
SHIPPING_LABEL_BASE_URL=http://localhost:3000/api/gw/shipping/labels
GHN_MODE=mock
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=sandbox-ghn-token
GHN_SHOP_ID=0

# --- Order Service Business Rules ---
# Note: COD max limit and standard payment expiry moved to payment_method_configs (DB single source of truth, F6).
ORDER_COD_MAX_REJECTED_COUNT=3
ORDER_COD_REQUIRE_PHONE_VERIFIED=true
ORDER_COD_MIN_ORDERS_FOR_RATE=3
ORDER_COD_MAX_REJECT_RATE_BPS=3000
ORDER_FLASH_PAYMENT_EXPIRY_MINUTES=5
ORDER_AUTO_COMPLETE_DAYS=7
ORDER_SELLER_CONFIRM_HOURS=48
ORDER_RETURN_SELLER_RESPONSE_DAYS=3
ORDER_RETURN_SHIP_DAYS=5
ORDER_RETURN_INSPECT_DAYS=3
ORDER_BATCH_SHIP_MAX_ITEMS=50

# --- Product Service CSV Import Limits (UC-S13, G6) ---
PRODUCT_IMPORT_MAX_ROWS=1000
PRODUCT_IMPORT_MAX_BYTES=1048576

# --- Search Service, Meilisearch & Embeddings (B1, ADR-0004, G12/G13) ---
# Meilisearch & search-postgres (pgvector/pgvector:0.8.7-pg16, >=0.8 for hnsw.iterative_scan) are internal compose containers only (no host ports).
SEARCH_GRPC_ADDR=localhost:50059
MEILISEARCH_URL=http://meilisearch:7700
MEILI_ENV=production
MEILI_MASTER_KEY=dev-only-meilisearch-master-key-change-me
MEILI_NO_ANALYTICS=true
MEILI_MAX_INDEXING_MEMORY=256Mb
# EMBEDDING_MODE=mock is default (deterministic offline hash vector); openai requires EMBEDDING_API_KEY and explicit approval (G12).
EMBEDDING_MODE=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=
SEARCH_RRF_K=60
SEARCH_MEILI_TIMEOUT_MS=1500
SEARCH_VECTOR_TIMEOUT_MS=800
SEARCH_VECTOR_MIN_SIMILARITY=0.25

# --- Promotion Service Business Rules ---
PROMOTION_VOUCHER_EXPIRY_NOTICE_HOURS=24

# --- Web Frontend (Next.js BFF) & Notification Links ---
# Host port for the compose `web` service (container listens on 3000; never use 3111).
WEB_PORT=3000
# Base URL used by notification emails (e.g. password reset links); compose defaults to http://localhost:${WEB_PORT:-3000}.
WEB_BASE_URL=http://localhost:3000
# Gateway URL used by Next.js server during host dev (`npm run dev`); compose overrides to http://gateway:8080.
GATEWAY_URL=http://localhost:8080
# Set false on local HTTP so HttpOnly session cookies work without TLS; set true behind HTTPS.
COOKIE_SECURE=false
# Public origin for CSRF Origin checks (compose defaults to http://localhost:${WEB_PORT:-3000}; set https://shop.example.com behind HTTPS reverse proxy).
APP_ORIGIN=http://localhost:3000
